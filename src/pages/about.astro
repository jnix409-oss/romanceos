---
import BaseLayout from '../layouts/BaseLayout.astro';
import { DIMENSIONS } from '../data/dimensions';
import { LENSES } from '../data/lenses';
import { getThreshold } from '../data/thresholds';
import { MIN_REVIEWS_SENSITIVE_LENS } from '../config';
---
<BaseLayout title="About" description="What Belongary is, how it works, and who's behind it.">
  <div class="max-w-3xl mx-auto px-4 py-12 sm:py-16">
    <h1 class="text-3xl sm:text-4xl font-heading font-bold text-plum mb-8">About Belongary</h1>

    <div class="space-y-6 text-ink/80 leading-relaxed">
      <p class="text-lg">
        Belongary is an anonymous workplace belonging review platform. We ask one question that most review sites skip: <em>would you tell someone like you to take this job?</em>
      </p>

      <p>
        Every review includes a free-text story, a headline recommendation (yes / no / depends), and ratings across eight dimensions of belonging. Reviewers can optionally tag their review with an identity lens so scores can be filtered by perspective — but only in aggregate, never individually.
      </p>

      <div class="bg-cream rounded-xl border border-border p-8 my-8">
        <h2 class="text-xl font-heading font-semibold text-plum mb-4">How Scores Work</h2>
        <ul class="space-y-3 text-ink/70 text-sm">
          <li class="flex items-start gap-2">
            <span class="text-coral font-bold mt-0.5">·</span>
            <span>Company scores go live after <strong>{getThreshold()} reviews</strong> from that company. Below that, only a progress bar is shown.</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="text-coral font-bold mt-0.5">·</span>
            <span>Identity lens scores require <strong>{MIN_REVIEWS_SENSITIVE_LENS} reviews</strong> sharing the same lens at the same company before they appear.</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="text-coral font-bold mt-0.5">·</span>
            <span>Companies cannot pay to hide, edit, or remove reviews. Moderation is limited to removing content that names individuals or contains slurs.</span>
          </li>
        </ul>
      </div>

      <h2 class="text-2xl font-heading font-semibold text-plum mt-10 mb-4">The Eight Dimensions</h2>
      <p>
        Every review rates these eight dimensions of belonging, each scored 1–5:
      </p>
      <div class="grid sm:grid-cols-2 gap-3 mt-4">
        {DIMENSIONS.map(dim => (
          <div class="flex items-center gap-3 p-3 bg-white rounded-lg border border-border">
            <img src={dim.icon} alt="" width="20" height="20" class="shrink-0" aria-hidden="true" />
            <span class="text-sm font-medium text-plum">{dim.label}</span>
          </div>
        ))}
      </div>

      <h2 class="text-2xl font-heading font-semibold text-plum mt-10 mb-4">Identity Lenses</h2>
      <p>
        Reviewers can optionally tag their review with one or more identity lenses. When {MIN_REVIEWS_SENSITIVE_LENS} or more people from the same company share a lens, that lens's aggregate scores appear on the company profile — never tied to a single review.
      </p>
      <div class="flex flex-wrap gap-2 mt-4">
        {LENSES.map(lens => (
          <span class="px-3 py-1 bg-cream text-ink/60 text-sm rounded-full border border-border">{lens.label}</span>
        ))}
      </div>

      <h2 class="text-2xl font-heading font-semibold text-plum mt-10 mb-4">Who We Are</h2>
      <p>
        Belongary was founded by someone who spent 18 years in HR and got tired of watching the same cycle: engagement surveys nobody acted on, employer branding that hid the truth, and people finding out too late that the culture they were sold wasn't the one they got.
      </p>
      <p>
        <a href="/founder" class="text-coral font-semibold hover:text-coral/80 transition-colors">Read the founder's full story &rarr;</a>
      </p>

      <h2 class="text-2xl font-heading font-semibold text-plum mt-10 mb-4">Contact</h2>
      <p>
        Questions, concerns, or removal requests: <a href="mailto:hello@belongary.com" class="text-coral hover:text-coral/80 transition-colors">hello@belongary.com</a>
      </p>

      <div class="mt-10 text-center">
        <a href="/" class="inline-flex items-center justify-center px-8 py-3 bg-coral text-white font-semibold rounded-lg hover:bg-coral/90 transition-colors shadow-sm">
          Share Your Story
        </a>
      </div>
    </div>
  </div>
</BaseLayout>
