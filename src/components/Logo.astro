---
interface Props {
  height?: number;
  dark?: boolean;
  class?: string;
}
const { height = 36, dark = false, class: className = '' } = Astro.props;
const iconH = height;
const iconW = Math.round(iconH * 0.7);
---
<span class:list={['inline-flex items-center gap-1.5', className]}>
  <svg
    width={iconW}
    height={iconH}
    viewBox="0 0 70 100"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
    aria-hidden="true"
    class="shrink-0"
  >
    {/* Outer arch — terra */}
    <path d="M35 0C15.67 0 0 15.67 0 35v65h70V35C70 15.67 54.33 0 35 0Z" fill="#D4654A" />
    {/* Inner arch — plum */}
    <path d="M35 10C21.19 10 10 21.19 10 35v55h50V35C60 21.19 48.81 10 35 10Z" fill="#352238" />
    {/* Overlapping circles */}
    <circle cx="25" cy="55" r="18" fill="#B84E3B" opacity="0.7" />
    <circle cx="40" cy="48" r="14" fill="#D4654A" opacity="0.5" />
    <circle cx="30" cy="72" r="16" fill="#C4896E" opacity="0.6" />
    <circle cx="22" cy="82" r="12" fill="#F4D4C3" opacity="0.7" />
    <circle cx="38" cy="85" r="10" fill="#FFF8F0" opacity="0.5" />
  </svg>
  <span
    class:list={[
      'font-body font-semibold tracking-tight leading-none',
      dark ? 'text-white' : 'text-plum',
    ]}
    style={`font-size: ${Math.round(height * 0.56)}px;`}
  >Belongary</span>
</span>
